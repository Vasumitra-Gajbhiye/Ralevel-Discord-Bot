{
  "name": "@ralevel/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared constants, permissions, utilities, and types for r/alevel",
  "dependencies": {
    "@ralevel/db": "workspace:*",
    "discord.js": "^14.11.0"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./permissions": {
      "types": "./src/permissions.d.ts",
      "default": "./src/permissions.js"
    },
    "./constants": {
      "types": "./src/constants.d.ts",
      "default": "./src/constants.js"
    },
    "./renderMessageTemplate": {
      "types": "./src/renderMessageTemplate.d.ts",
      "default": "./src/renderMessageTemplate.js"
    },
    "./registerGuildCommands": {
      "types": "./src/registerGuildCommands.d.ts",
      "default": "./src/registerGuildCommands.js"
    },
    "./commandPermissions": {
      "types": "./src/commandPermissions.d.ts",
      "default": "./src/commandPermissions.js"
    },
    "./commandCatalog": {
      "default": "./src/commandCatalog.js"
    },
    "./commandDisplayNames": {
      "types": "./src/commandDisplayNames.d.ts",
      "default": "./src/commandDisplayNames.js"
    },
    "./commandMetadataOverrides": {
      "types": "./src/commandMetadataOverrides.d.ts",
      "default": "./src/commandMetadataOverrides.js"
    }
  }
}
